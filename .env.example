# Copie este arquivo para .env e preencha com as credenciais do seu projeto Supabase
# (Project Settings > Database > Connection string, modo "Transaction pooler")
DATABASE_URL="postgresql://postgres:[password]@[host]:6543/postgres"

# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Usada para OCR de notas fiscais/faturas e para os alertas de IA (v1/v2)
ANTHROPIC_API_KEY=""
